# Salin menjadi .env.local lalu sesuaikan
DATABASE_URL=postgresql://postgres:password@localhost:5432/kursus
# Isi dengan string acak panjang, mis: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Isi true hanya jika aplikasi diakses lewat HTTPS (mis. saat deploy)
COOKIE_SECURE=false
